{
  "openapi": "3.0.3",
  "info": {
    "title": "AV Live Studio API",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "av_session"
      },
      "desktop": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Command": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 80
          },
          "text": {
            "type": "string",
            "maxLength": 300
          },
          "target": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "maxLength": 100
          },
          "points": {
            "type": "integer",
            "enum": [
              1,
              10,
              50
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "connected": {
            "type": "boolean"
          },
          "stage": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Event": {
        "type": "object",
        "required": [
          "seq",
          "kind",
          "payload",
          "created"
        ],
        "properties": {
          "seq": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "type": "string",
            "enum": [
              "broadcast",
              "chat",
              "gift",
              "guest",
              "mute",
              "kick",
              "pk"
            ]
          },
          "payload": {
            "type": "object"
          },
          "created": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "summary": "register",
        "responses": {
          "200": {
            "description": "Success; application JSON snapshot or command result"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing/expired session"
          },
          "403": {
            "description": "Permission denied"
          },
          "409": {
            "description": "State conflict, quota or capacity"
          },
          "429": {
            "description": "Rate limited"
          },
          "502": {
            "description": "Media unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_]{3,32}$"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 128
                  },
                  "old_password": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
