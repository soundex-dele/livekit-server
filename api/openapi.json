{
  "openapi": "3.1.0",
  "info": {"title": "AV Remote Assistance API", "version": "1.0.0", "description": "Single-instance Go + SQLite service. Host and controller bearer credentials are scoped to one pairing. Media tokens do not authorize input injection."},
  "servers": [{"url": "/api/v1"}],
  "security": [{"credential": []}],
  "paths": {
    "/pairings": {"post": {"operationId": "createPairing", "security": [], "description": "Create 5-minute pairing with 10-digit code and an in-memory host credential. Rate limited to 10 per minute per source IP.", "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"allOf": [{"$ref": "#/components/schemas/Grant"}, {"type": "object", "required": ["credential", "pairing_code"], "properties": {"credential": {"type": "string"}, "pairing_code": {"type": "string", "pattern": "^[0-9]{10}$"}}}]}}}}, "default": {"$ref": "#/components/responses/Error"}}}},
    "/pairings/redeem": {"post": {"operationId": "requestControl", "security": [], "description": "Atomically claim a waiting code. First claimant wins. A retry after success receives code_unavailable; create a new pairing if the credential response is lost.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["code"], "properties": {"code": {"type": "string", "pattern": "^[0-9]{10}$"}, "name": {"type": "string", "description": "Unverified display name; at most 80 UTF-8 bytes"}}}}}}, "responses": {"201": {"description": "Pending local approval", "content": {"application/json": {"schema": {"allOf": [{"$ref": "#/components/schemas/Grant"}, {"type": "object", "required": ["credential"], "properties": {"credential": {"type": "string"}}}]}}}}, "default": {"$ref": "#/components/responses/Error"}}}},
    "/pairings/{id}": {"parameters": [{"$ref": "#/components/parameters/id"}], "get": {"operationId": "getPairing", "responses": {"200": {"$ref": "#/components/responses/Grant"}, "default": {"$ref": "#/components/responses/Error"}}}},
    "/pairings/{id}/close": {"parameters": [{"$ref": "#/components/parameters/id"}], "post": {"operationId": "closePairing", "description": "Either credential can close its own pairing; idempotent. Stops future connect/renew and schedules media cleanup.", "responses": {"200": {"$ref": "#/components/responses/Grant"}, "default": {"$ref": "#/components/responses/Error"}}}},
    "/control-grants/{id}": {"parameters": [{"$ref": "#/components/parameters/id"}], "get": {"operationId": "getGrant", "responses": {"200": {"$ref": "#/components/responses/Grant"}, "default": {"$ref": "#/components/responses/Error"}}}},
    "/control-grants/{id}/approve": {"parameters": [{"$ref": "#/components/parameters/id"}], "post": {"operationId": "approveGrant", "description": "Host only, after local consent. Pending -> approved with 10-second lease. Duplicate approval does not extend the lease.", "responses": {"200": {"$ref": "#/components/responses/Grant"}, "default": {"$ref": "#/components/responses/Error"}}}},
    "/control-grants/{id}/reject": {"parameters": [{"$ref": "#/components/parameters/id"}], "post": {"operationId": "rejectGrant", "description": "Host only. Idempotent rejection; code cannot be reused.", "responses": {"200": {"$ref": "#/components/responses/Grant"}, "default": {"$ref": "#/components/responses/Error"}}}},
    "/control-grants/{id}/renew": {"parameters": [{"$ref": "#/components/parameters/id"}], "post": {"operationId": "renewGrant", "description": "Host only. Approved, unexpired grants may renew to 10 seconds. Expired/revoked grants never revive. Host polls every 3 seconds and derives a conservative monotonic deadline from request start + lease_remaining_ms.", "responses": {"200": {"$ref": "#/components/responses/Grant"}, "default": {"$ref": "#/components/responses/Error"}}}},
    "/control-grants/{id}/revoke": {"parameters": [{"$ref": "#/components/parameters/id"}], "post": {"operationId": "revokeGrant", "description": "Either peer. Idempotent; local host releases input before calling. Polling or lease expiry bounds remote enforcement.", "responses": {"200": {"$ref": "#/components/responses/Grant"}, "default": {"$ref": "#/components/responses/Error"}}}},
    "/control-grants/{id}/connect": {"parameters": [{"$ref": "#/components/parameters/id"}], "post": {"operationId": "connectMedia", "description": "Approved peers only. Ensures a two-participant room and returns a 60-second join token; expiration is not connected-session revocation.", "responses": {"200": {"description": "Media credentials (memory only)", "content": {"application/json": {"schema": {"type": "object", "required": ["media_url", "media_token", "participant_identity", "expires_at"], "properties": {"media_url": {"type": "string"}, "media_token": {"type": "string"}, "participant_identity": {"type": "string"}, "expires_at": {"type": "string", "format": "date-time"}}}}}}, "default": {"$ref": "#/components/responses/Error"}}}}
  },
  "components": {
    "securitySchemes": {"credential": {"type": "http", "scheme": "bearer"}},
    "parameters": {"id": {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[0-9a-f]{32}$"}}},
    "responses": {
      "Grant": {"description": "Current authoritative state", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Grant"}}}},
      "Error": {"description": "400 invalid input, 401 missing credential, 403 wrong role/origin, 404 unavailable code/resource, 405 wrong method, 409 invalid transition, 429 rate limit, 500 persistence error, 502 media unavailable, 503 code collision", "content": {"application/json": {"schema": {"type": "object", "required": ["error", "request_id"], "properties": {"request_id": {"type": "string"}, "error": {"type": "object", "required": ["code", "message", "retryable"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "retryable": {"type": "boolean"}}}}}}}}
    },
    "schemas": {
      "Grant": {"type": "object", "required": ["id", "grant_id", "state", "controller_name", "epoch", "expires_at", "lease_expires_at", "lease_remaining_ms", "host_identity", "controller_identity", "scope"], "properties": {
        "id": {"type": "string"}, "grant_id": {"type": "string"}, "state": {"enum": ["waiting", "pending", "approved", "rejected", "revoked", "expired"]},
        "controller_name": {"type": "string"}, "epoch": {"type": "integer", "minimum": 1}, "expires_at": {"type": "string", "format": "date-time"}, "lease_expires_at": {"type": "string", "format": "date-time"}, "lease_remaining_ms": {"type": "integer", "minimum": 0, "maximum": 10000}, "host_identity": {"type": "string"}, "controller_identity": {"type": "string"}, "scope": {"type": "array", "items": {"enum": ["screen", "keyboard", "mouse"]}}
      }}
    }
  }
}
