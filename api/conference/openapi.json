        "scheme": "bearer"
      }
    },
    "schemas": {
      "Command": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 100
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "duration_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440,
            "default": 60
          },
          "password": {
            "type": "string",
            "maxLength": 64
          },
          "waiting_room": {
            "type": "boolean",
            "default": true
          },
          "scheduled": {
            "type": "boolean"
          },
          "number": {
            "type": "string",
            "pattern": "^[0-9]{9}$"
          },
          "name": {
            "type": "string",
            "maxLength": 40
          },
          "target": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "member_id": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
