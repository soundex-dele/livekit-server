{
  "openapi": "3.0.3",
  "info": {
    "title": "AV Meeting API",
    "version": "1.0.0",
    "description": "Single-instance 25-person meetings. Account API /api/v1/auth/ preserves existing register/login/logout/refresh/password/me contracts. Desktop sends X-AV-Client: desktop and receives session_token. Commands return accepted plus durable operations (pending/retrying/done); accepted is not confirmation of media effects."
  },
