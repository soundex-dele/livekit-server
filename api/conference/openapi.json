      "post": {
        "summary": "Create an unguessable guest credential (guest_token)",
        "security": [],
        "responses": {
          "200": {
            "description": "Successful result"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required or expired"
          },
          "403": {
            "description": "Policy or role denied"
          },
          "404": {
            "description": "Meeting not found"
          },
          "409": {
            "description": "State, capacity or idempotency conflict"
          },
          "429": {
            "description": "Rate limited"
          },
          "503": {
            "description": "Service unavailable; operation may need retry"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Required for creation and management commands; reuse on uncertain retries."
          }
        ],
