# Reference only: the service reads process environment, not this file.
PF_ADDR=127.0.0.1:8080
PF_PG_DSN=postgres://av:replace_password@127.0.0.1:5432/av?sslmode=disable
PF_MODULES=organizations,jobs,events
PF_PUBLIC_ORIGIN=http://127.0.0.1:8080
PF_REGISTRATION=false
AV_REDIS_URL=redis://:replace_password@127.0.0.1:6379/0
AV_MODULES=screen-cast,conference,remote-control,live-studio
AV_MEDIA_NODES_FILE=deploy/media-nodes.json
# Bootstrap only; remove from the serving process after initialization.
PF_ADMIN_NAME=admin
PF_ADMIN_PASSWORD=replace_with_a_unique_password
AV_ORGANIZATION_NAME=My organization
# Development alternative: unset PF_PG_DSN and set PF_SQLITE_PATH.
# PF_SQLITE_PATH=out/development.db
# AV_EPHEMERAL=memory is restricted to explicit SQLite development.
# Static Web artifacts are optional and must use the same public origin.
# AV_SCREEN_CAST_WEB=../livekit-app/apps/screen-cast/web/dist
# AV_REMOTE_CONTROL_WEB=../livekit-app/apps/remote-control/web/dist
# AV_LIVE_STUDIO_WEB=../livekit-app/apps/live-studio/web/dist
